        icon: "📱",
        sale: true
    },

    {
        id: 7,
        name: "Infinix Note 40",
        brand: "infinix",
        category: "phones",
        price: 23999,
        oldPrice: 27999,
        discount: 14,
        rating: 4.5,
        icon: "📱",
        sale: true
    },

    {
        id: 8,
        name: "Samsung Galaxy S24",
        brand: "samsung",
        category: "phones",
        price: 84999,
        oldPrice: 94999,
        discount: 11,
        rating: 4.9,
        icon: "📱",
        sale: false
    },

    {
        id: 9,
        name: "Oraimo FreePods 4",
        brand: "oraimo",
        category: "electronics",
        price: 3499,
        oldPrice: 4999,
        discount: 30,
        rating: 4.4,
        icon: "🎧",
        sale: true
    },

    {
        id: 10,
        name: "HP 15 Laptop",
        brand: "hp",
        category: "electronics",
        price: 54999,
        oldPrice: 64999,
        discount: 15,
        rating: 4.5,
        icon: "💻",
        sale: true
    }

];


/* =========================================
   CART
========================================= */

let cart =
    JSON.parse(
        localStorage.getItem("jumiaKenyaCart")
    ) || [];


function saveCart() {

    localStorage.setItem(
        "jumiaKenyaCart",
        JSON.stringify(cart)
    );

    updateCartCount();
}


function addToCart(id) {

    const product =
        products.find(
            product => product.id === id
        );

    const existing =
        cart.find(
            item => item.id === id
        );

    if (existing) {

        existing.quantity++;

    } else {

        cart.push({
            ...product,
            quantity: 1
        });

    }

    saveCart();

    alert(
        product.name +
        " added to cart!"
    );
}


function removeFromCart(id) {

    cart =
        cart.filter(
            item => item.id !== id
        );

    saveCart();

    displayCart();
}


function updateCartCount() {

    const count =
        cart.reduce(
            (total, item) =>
                total + item.quantity,
            0
        );

    document.getElementById(
        "cartCount"
    ).textContent = count;
}


/* =========================================
   PRODUCT DISPLAY
========================================= */

function productHTML(product) {

    return `

        <div class="product-card">

            <div class="product-image">
                ${product.icon}
            </div>

            <span class="discount">
                -${product.discount}%
            </span>

            <div class="product-info">

                <div class="product-name">
                    ${product.name}
                </div>

                <div class="rating">
                    ★★★★☆ ${product.rating}
                </div>

                <div class="old-price">
                    KSh ${product.oldPrice.toLocaleString()}
                </div>

                <div class="price">
                    KSh ${product.price.toLocaleString()}
                </div>

                <button
                    class="add-cart"
                    onclick="addToCart(${product.id})">

                    🛒 Add to Cart

                </button>

            </div>

        </div>

    `;
}


function displayProducts(list = products) {

    document.getElementById(
        "productGrid"
    ).innerHTML =
        list.map(productHTML).join("");
}


function displayFlashSale() {

    const saleProducts =
        products.filter(
            product => product.sale
        );

    document.getElementById(
        "flashProducts"
    ).innerHTML =
        saleProducts
        .slice(0, 5)
        .map(productHTML)
        .join("");
}


/* =========================================
   SEARCH
========================================= */

function searchProducts() {

    const query =
        document
        .getElementById("searchInput")
        .value
        .toLowerCase()
        .trim();

    const results =
        products.filter(product =>

            product.name
            .toLowerCase()
            .includes(query)

            ||

            product.brand
            .toLowerCase()
            .includes(query)

            ||

            product.category
            .toLowerCase()
            .includes(query)

        );

    displayProducts(results);

    document
        .getElementById("products")
        .scrollIntoView({
            behavior: "smooth"
        });
}


document
    .getElementById("searchInput")
    .addEventListener(
        "input",
        searchProducts
    );


/* =========================================
   CATEGORIES
========================================= */

function filterCategory(category) {

    let results;

    if (category === "all") {

        results = products;

    } else {

        results =
            products.filter(product =>

                product.category === category
                ||
                product.brand === category

            );

    }

    displayProducts(results);

    document
        .getElementById("products")
        .scrollIntoView({
            behavior: "smooth"
        });
}


function filterSale() {

    const results =
        products.filter(
            product => product.sale
        );

    displayProducts(results);

    document
        .getElementById("products")
        .scrollIntoView({
            behavior: "smooth"
        });
}


/* =========================================
   SORT
========================================= */

function sortProducts() {

    const type =
        document
        .getElementById("sortProducts")
        .value;

    let sorted = [...products];

    if (type === "low") {

        sorted.sort(
            (a,b) => a.price - b.price
        );

    }

    if (type === "high") {

        sorted.sort(
            (a,b) => b.price - a.price
        );

    }

    if (type === "discount") {

        sorted.sort(
            (a,b) =>
                b.discount - a.discount
        );

    }

    displayProducts(sorted);
}



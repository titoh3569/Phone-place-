/* =========================================
   FLASH SALE COUNTDOWN
========================================= */

let saleEnd =
    Date.now() +
    (6 * 60 * 60 * 1000);


function updateCountdown() {

    let difference =
        saleEnd - Date.now();

    if (difference <= 0) {

        saleEnd =
            Date.now() +
            (6 * 60 * 60 * 1000);

        difference =
            saleEnd - Date.now();
    }

    const hours =
        Math.floor(
            difference /
            (1000 * 60 * 60)
        );

    const minutes =
        Math.floor(
            (difference %
                (1000 * 60 * 60)) /
            (1000 * 60)
        );

    const seconds =
        Math.floor(
            (difference %
                (1000 * 60)) /
            1000
        );


    document.getElementById(
        "hours"
    ).textContent =
        String(hours).padStart(2,"0");


    document.getElementById(
        "minutes"
    ).textContent =
        String(minutes).padStart(2,"0");


    document.getElementById(
        "seconds"
    ).textContent =
        String(seconds).padStart(2,"0");
}



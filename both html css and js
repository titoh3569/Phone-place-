<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JumiaKenya - Phones & Electronics</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f5f5;
    color: #333;
}

.container {
    width: 92%;
    max-width: 1250px;
    margin: auto;
}

/* TOP BAR */
.topbar {
    background: #f1f1f1;
    padding: 9px 0;
    font-size: 13px;
}

.top-content {
    display: flex;
    justify-content: space-between;
}

.top-content a {
    margin-left: 20px;
    color: #555;
    text-decoration: none;
}

/* HEADER */
.header {
    background: #f68b1e;
    padding: 15px 0;
}

.header-content {
    display: flex;
    align-items: center;
    gap: 20px;
}

.logo {
    color: white;
    font-size: 30px;
    font-weight: bold;
    min-width: 130px;
}

.logo small {
    display: block;
    font-size: 12px;
    font-weight: normal;
}

.search-box {
    flex: 1;
    display: flex;
}

.search-box input {
    width: 100%;
    padding: 14px;
    border: none;
    outline: none;
    font-size: 15px;
}

.search-box button {
    background: #333;
    color: white;
    border: none;
    padding: 0 25px;
    cursor: pointer;
}

.account-btn,
.cart-btn {
    border: none;
    background: white;
    padding: 13px 16px;
    cursor: pointer;
    border-radius: 3px;
}

.cart-btn {
    position: relative;
}

#cartCount {
    background: red;
    color: white;
    border-radius: 50%;
    padding: 3px 7px;
    font-size: 11px;
    position: absolute;
    top: -7px;
    right: -7px;
}

/* CATEGORIES */
.categories {
    background: white;
    box-shadow: 0 1px 4px #ddd;
}

.category-list {
    display: flex;
    overflow-x: auto;
}

.category-list button {
    border: none;
    background: white;
    padding: 16px 20px;
    cursor: pointer;
    white-space: nowrap;
}

.category-list button:hover {
    color: #f68b1e;
}

/* HERO */
.hero {
    background: linear-gradient(120deg, #ff8a00, #f4511e);
    color: white;
    margin-top: 15px;
}

.hero-content {
    min-height: 320px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.hero-small {
    font-weight: bold;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: 45px;
    line-height: 1.1;
}

.hero h1 span {
    color: #ffe600;
}

.hero p {
    margin: 15px 0;
}

.hero button,
.promo button {
    background: white;
    color: #e85c00;
    border: none;
    padding: 14px 25px;
    font-weight: bold;
    cursor: pointer;
}

.hero-phone {
    font-size: 190px;
    transform: rotate(-10deg);
}

/* SERVICES */
.services {
    background: white;
    margin: 15px 0;
    padding: 20px 0;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.service {
    display: flex;
    gap: 12px;
    align-items: center;
    border-right: 1px solid #ddd;
}

.service span {
    font-size: 30px;
}

.service small {
    display: block;
    color: #777;
    margin-top: 4px;
}

/* SECTION */
.flash-section,
.products-section {
    margin: 20px auto;
}

.section-heading {
    background: white;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.section-heading h2 {
    font-size: 23px;
}

.section-heading button {
    border: none;
    background: none;
    color: #f68b1e;
    cursor: pointer;
    font-weight: bold;
}

.flash-heading {
    border-left: 5px solid #f68b1e;
}

.countdown {
    font-weight: bold;
}

.countdown b {
    background: #222;
    color: white;
    padding: 7px;
    border-radius: 3px;
}

/* PRODUCTS */
.products-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
}

.product-card {
    background: white;
    position: relative;
    transition: 0.2s;
    overflow: hidden;
}

.product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 15px #ccc;
}

.product-image {
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    font-size: 100px;
}

.discount {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #ffe5cc;
    color: #e85c00;
    padding: 5px 8px;
    font-size: 12px;
    font-weight: bold;
}

.product-info {
    padding: 12px;
}

.product-name {
    height: 40px;
    font-size: 14px;
    line-height: 20px;
}

.rating {
    color: #ff9800;
    margin: 7px 0;
}

.old-price {
    text-decoration: line-through;
    color: #999;
    font-size: 13px;
}

.price {
    font-size: 20px;
    font-weight: bold;
    margin-top: 3px;
}

.add-cart {
    width: 100%;
    margin-top: 10px;
    border: none;
    background: #f68b1e;
    color: white;
    padding: 10px;
    cursor: pointer;
    font-weight: bold;
}

.add-cart:hover {
    background: #e87508;
}

/* PROMOTION */
.promo {
    background: #222;
    color: white;
    margin: 30px 0;
}

.promo-content {
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.promo span {
    color: #ff9b32;
    font-weight: bold;
}

.promo h2 {
    margin: 10px 0;
    font-size: 28px;
}

/* MODAL */
.modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.65);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    padding: 15px;
}

.modal {
    background: white;
    width: 100%;
    max-width: 500px;
    padding: 25px;
    position: relative;
    border-radius: 5px;
    max-height: 90vh;
    overflow-y: auto;
}

.modal h2 {
    margin-bottom: 20px;
}

.close {
    position: absolute;
    right: 15px;
    top: 10px;
    border: none;
    background: none;
    font-size: 30px;
    cursor: pointer;
}

/* CART */
.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ddd;
    padding: 12px 0;
}

.cart-item-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.cart-icon {
    font-size: 40px;
}

.remove-btn {
    border: none;
    background: #eee;
    padding: 6px;
    cursor: pointer;
}

.cart-total {
    display: flex;
    justify-content: space-between;
    font-size: 20px;
    padding: 20px 0;
}

.checkout-btn,
.login-btn {
    width: 100%;
    border: none;
    background: #f68b1e;
    color: white;
    padding: 14px;
    cursor: pointer;
    font-weight: bold;
}

/* ACCOUNT */
.account-modal input {
    display: block;
    width: 100%;
    padding: 13px;
    margin: 10px 0;
    border: 1px solid #ddd;
}

.register {
    text-align: center;
    margin-top: 20px;
}

.register a {
    color: #f68b1e;
}

/* FOOTER */
footer {
    background: #333;
    color: white;
    margin-top: 50px;
}

.footer-grid {
    padding: 45px 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
}

.footer-grid h3 {
    margin-bottom: 15px;
}

.footer-grid a {
    display: block;
    color: #ddd;
    text-decoration: none;
    margin: 8px 0;
}

.footer-grid p {
    color: #ddd;
    margin: 8px 0;
}

.copyright {
    text-align: center;
    padding: 15px;
    border-top: 1px solid #555;
    color: #ccc;
}

/* MOBILE */
@media (max-width: 900px) {

    .header-content {
        flex-wrap: wrap;
    }

    .logo {
        min-width: auto;
    }

    .search-box {
        order: 3;
        flex-basis: 100%;
    }

    .products-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero h1 {
        font-size: 35px;
    }

    .hero-phone {
        font-size: 120px;
    }
}

@media (max-width: 600px) {

    .top-content {
        display: none;
    }

    .header {
        padding: 12px 0;
    }

    .account-btn,
    .cart-btn {
        padding: 10px;
    }

    .hero-content {
        min-height: 260px;
    }

    .hero h1 {
        font-size: 30px;
    }

    .hero-phone {
        font-size: 75px;
    }

    .products-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .product-image {
        height: 150px;
        font-size: 75px;
    }

    .service-grid {
        grid-template-columns: 1fr;
    }

    .service {
        border-right: none;
        border-bottom: 1px solid #ddd;
        padding-bottom: 12px;
    }

    .promo-content {
        flex-direction: column;
        text-align: center;
        justify-content: center;
        gap: 20px;
        padding: 30px 0;
    }

    .section-heading {
        flex-wrap: wrap;
        gap: 10px;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}
</style>
</head>

